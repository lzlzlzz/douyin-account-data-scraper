# ══════════════════════════════════════════════════════════════
#  抖音账号管理 + 数据抓取系统 · 配置模板
#  用法：拷贝本文件为 .env 并逐项填写（本文件不含真实凭据，切勿外传真实 .env）
#  位置：login_bot/.env（所有脚本统一从这里读取）
# ══════════════════════════════════════════════════════════════

# ── ① 钉钉 AI 表应用（读写「抖音店铺账号登记表」）─────────────
# 钉钉开发者后台 → 应用 → 凭据信息（该应用为 REST 调用，可多端共用）
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
# 操作人 userId（钉钉管理后台 → 通讯录 → 成员 UserId）
DINGTALK_OPERATOR_ID=

# ── ② 抖音登录机器人（Stream 模式，独立应用）─────────────────
# ⚠️ 凭据铁律：同一应用多个 Stream 连接会「随机抢消息」！
#    两台电脑不可共用同一应用；换机部署要么新应用，要么旧机停机
DOUYIN_LOGIN_BOT_CLIENT_ID=
DOUYIN_LOGIN_BOT_CLIENT_SECRET=
# 机器人在群内的显示名（可选，默认「抖音登录助手」）
DY_LOGIN_BOT_NAME=抖音机器人

# ── ③ 腾讯云 COS 图床（登录二维码转外链发到群）──────────────
# 腾讯云控制台 → 访问管理 → API 密钥；COS → 存储桶（公共读）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-shanghai
COS_BUCKET=
# 可选：自定义域名/加速域名（留空自动拼 https://{bucket}.cos.{region}.myqcloud.com）
COS_PUBLIC_BASE_URL=

# ── ④ Cookie 巡检告警（群自定义机器人 webhook，加签）─────────
# 钉钉群 → 群设置 → 智能群助手 → 添加机器人 → 自定义（Webhook）
# ⚠️ 各项目的 webhook 严禁混用（会把消息发到别的群）
DY_ALERT_WEBHOOK_URL=
DY_ALERT_WEBHOOK_SECRET=

# ── ⑤ 巡检参数（可选，默认即可）─────────────────────────────
DY_MONITOR_ENABLED=1        # 1=启用巡检；0=关闭
DY_MONITOR_INTERVAL=21600   # 巡检间隔（秒），21600=6 小时
DY_MONITOR_INITIAL_DELAY=180  # bot 启动后首轮延迟（秒）

# ── ⑥ 调试项（一般留空）─────────────────────────────────────
# DY_PROFILE_DIR=           # 浏览器 profile 目录（默认 login_bot/output/dy-browser-profile）
# DY_BROWSER_HEADLESS=0     # 1=无头浏览器（会被风控，仅排障用）
